# Quran Vision v6.2.2 — Cross-Platform Line Ending (LF) & Binary Lock
* text=auto eol=lf

*.md text eol=lf
*.py text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.html text eol=lf
*.txt text eol=lf
*.cff text eol=lf
*.sh text eol=lf
*.sha256 text eol=lf
*.ini text eol=lf

*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.docx binary
